#!/bin/bash

# omarchy:summary=Distro-agnostic package management (pacman/yay, dnf, apt, flatpak) with pkgmap name translation
# omarchy:args=<install|remove|search|list-installed|is-missing|is-present|resolve|update|update-all> [names...]
# omarchy:examples=omarchy pm install cursor-bin
# omarchy:requires-sudo=true

# Backends are selected automatically (pacman -> dnf -> apt -> flatpak) or
# forced with OMARCHY_PM (e.g. OMARCHY_PM=dnf) for testing and CI.
#
# Package names are resolved through the user's pkgmap
# (~/.config/omarchy/pkgmap/pkgmap.conf) which translates Arch package names
# to the active distro backend or a Flatpak app. Names without a pkgmap entry
# pass through to the native backend unchanged (most names match across
# distros). See docs/pkgmap.md.

set -u

PKGMAP_FILE="$HOME/.config/omarchy/pkgmap/pkgmap.conf"

backends=(pacman dnf apt flatpak)
declare -A BACKEND_CMDS=(
  [pacman]=pacman
  [dnf]=dnf
  [apt]=apt-get
  [flatpak]=flatpak
)
declare -A BACKEND_KNOWN=(
  [pacman]=0 [dnf]=0 [apt]=0 [flatpak]=0
)

detect_backend() {
  local b
  if [[ -n ${OMARCHY_PM-} ]]; then
    echo "$OMARCHY_PM"
    return
  fi
  for b in "${backends[@]}"; do
    if command -v "${BACKEND_CMDS[$b]}" >/dev/null 2>&1; then
      echo "$b"
      return
    fi
  done
  echo none
}

BACKEND=$(detect_backend)

has_flatpak() { command -v flatpak >/dev/null 2>&1; }
has_yay() { command -v yay >/dev/null 2>&1; }

# --- pkgmap ---------------------------------------------------------------

declare -A PKGMAP_ENTRIES=()
declare -A PKGMAP_TARGETS=()

load_pkgmap() {
  [[ -f $PKGMAP_FILE ]] || return 0
  local line name field key value rest
  while IFS= read -r line; do
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -n $line ]] || continue
    IFS='|' read -r name rest <<<"$line"
    name="${name//[[:space:]]/}"
    [[ -n $name ]] || continue
    PKGMAP_ENTRIES[$name]=1
    for field in $(printf '%s\n' "$rest" | tr '|' '\n'); do
      field="${field//[[:space:]]/}"
      if [[ $field == unsupported ]]; then
        PKGMAP_TARGETS[$name]="unsupported"
      elif [[ $field == *=* ]]; then
        key="${field%%=*}"
        value="${field#*=}"
        [[ -n $key && -n $value ]] || continue
        PKGMAP_TARGETS[$name]="${PKGMAP_TARGETS[$name]:-}${PKGMAP_TARGETS[$name]:+ }$key:$value"
      fi
    done
  done <"$PKGMAP_FILE"
}

pkgmap_target() {
  local name="$1" entry
  entry="${PKGMAP_TARGETS[$name]-}"
  [[ -n $entry ]] || return 1
  local field
  for field in $entry; do
    if [[ $field == unsupported ]]; then echo "unsupported"; return 0; fi
    if [[ $field == "$BACKEND:"* ]]; then echo "native:${field#*:}"; return 0; fi
  done
  if [[ $entry == *"flatpak:"* ]] && has_flatpak; then
    echo "flatpak:${entry#*flatpak:}"
    return 0
  fi
  return 1
}

# Resolve an Arch (or pass-through) package name to (kind, target).
# kind: native | flatpak | unsupported | passthrough
resolve_pkg() {
  local name="$1" t
  if t=$(pkgmap_target "$name"); then
    case "$t" in
      native:*) echo "native ${t#native:}" ;;
      flatpak:*) echo "flatpak ${t#flatpak:}" ;;
      unsupported) echo "unsupported $name" ;;
    esac
    return 0
  fi
  if [[ ${PKGMAP_ENTRIES[$name]-} ]]; then
    echo "unavailable $name"
    return 0
  fi
  echo "passthrough $name"
}

# --- backend primitives ----------------------------------------------------

run_sudo() {
  if (( EUID == 0 )); then
    "$@"
  else
    sudo "$@"
  fi
}

native_installed() {
  local name="$1"
  case "$BACKEND" in
    pacman) pacman -Q "$name" &>/dev/null ;;
    dnf) rpm -q "$name" &>/dev/null ;;
    apt) [[ $(dpkg-query -W -f='${db:Status-Status}' "$name" 2>/dev/null) == installed ]] ;;
    *) return 1 ;;
  esac
}

flatpak_installed() {
  flatpak info "$1" >/dev/null 2>&1
}

native_install() {
  case "$BACKEND" in
    pacman) run_sudo pacman -S --noconfirm --needed "$@" ;;
    dnf) run_sudo dnf install -y "$@" ;;
    apt) run_sudo apt-get install -y "$@" ;;
    *) echo "Error: no native backend for package install" >&2; return 1 ;;
  esac
}

native_remove() {
  case "$BACKEND" in
    pacman) run_sudo pacman -Rns --noconfirm "$@" ;;
    dnf) run_sudo dnf remove -y "$@" ;;
    apt) run_sudo apt-get remove -y "$@" ;;
    *) return 1 ;;
  esac
}

native_update() {
  case "$BACKEND" in
    pacman) run_sudo pacman -Syu --noconfirm ;;
    dnf) run_sudo dnf upgrade --refresh -y ;;
    apt) run_sudo apt-get update && run_sudo apt-get upgrade -y ;;
    *) return 1 ;;
  esac
}

native_search() {
  case "$BACKEND" in
    pacman) pacman -Ss "$1" ;;
    dnf) dnf search "$1" ;;
    apt) apt-cache search "$1" ;;
    *) return 1 ;;
  esac
}

native_list_installed() {
  case "$BACKEND" in
    pacman) pacman -Qq ;;
    dnf) rpm -qa --qf '%{NAME}\n' ;;
    apt) dpkg-query -W -f='${Package}\n' ;;
    *) return 1 ;;
  esac
}

# --- subcommands -----------------------------------------------------------

cmd_is_missing() {
  local name kind target
  for name in "$@"; do
    read -r kind target <<<"$(resolve_pkg "$name")"
    case "$kind" in
      native|passthrough) native_installed "$target" || return 0 ;;
      flatpak) flatpak_installed "$target" || return 0 ;;
      unsupported|unavailable) return 0 ;;
    esac
  done
  return 1
}

cmd_is_present() {
  local name kind target
  for name in "$@"; do
    read -r kind target <<<"$(resolve_pkg "$name")"
    case "$kind" in
      native|passthrough) native_installed "$target" || return 1 ;;
      flatpak) flatpak_installed "$target" || return 1 ;;
      unsupported) return 1 ;;
    esac
  done
  return 0
}

cmd_install() {
  [[ -n $BACKEND && $BACKEND != none ]] || { echo "Error: no package manager found" >&2; exit 1; }
  local native=() flatpak=() failed=0 name kind target
  for name in "$@"; do
    read -r kind target <<<"$(resolve_pkg "$name")"
    case "$kind" in
      native|passthrough) native+=("$target") ;;
      flatpak) flatpak+=("$target") ;;
      unsupported|unavailable)
        echo -e "\033[33mWarning: '$name' is not available on this distro (pkgmap: $kind)\033[0m" >&2
        failed=1
        ;;
    esac
  done
  if ((${#native[@]} > 0)); then
    native_install "${native[@]}" || exit 1
    for name in "${native[@]}"; do
      native_installed "$name" || {
        echo -e "\033[31mError: Package '$name' did not install\033[0m" >&2
        exit 1
      }
    done
  fi
  if ((${#flatpak[@]} > 0)); then
    flatpak install --noninteractive "${flatpak[@]}" || exit 1
    for name in "${flatpak[@]}"; do
      flatpak_installed "$name" || {
        echo -e "\033[31mError: Flatpak '$name' did not install\033[0m" >&2
        exit 1
      }
    done
  fi
  exit "$failed"
}

cmd_remove() {
  local native=() flatpak=() name kind target
  for name in "$@"; do
    read -r kind target <<<"$(resolve_pkg "$name")"
    case "$kind" in
      native|passthrough)
        native_installed "$target" && native+=("$target")
        ;;
      flatpak)
        flatpak_installed "$target" && flatpak+=("$target")
        ;;
    esac
  done
  ((${#native[@]} > 0)) && native_remove "${native[@]}"
  ((${#flatpak[@]} > 0)) && flatpak uninstall --noninteractive -y "${flatpak[@]}"
  return 0
}

cmd_search() {
  native_search "$1" || true
  if has_flatpak; then
    echo
    echo "Flatpak:"
    flatpak search "$1"
  fi
}

cmd_list_installed() {
  native_list_installed
  if has_flatpak; then
    echo
    echo "Flatpak:"
    flatpak list --app --columns=application
  fi
}

cmd_update() {
  native_update
}

cmd_update_all() {
  cmd_update
  if has_flatpak; then
    flatpak update -y
  fi
}

cmd_resolve() {
  local name kind target
  for name in "$@"; do
    read -r kind target <<<"$(resolve_pkg "$name")"
    case "$kind" in
      native|passthrough) echo "$name -> $target" ;;
      flatpak) echo "$name -> flatpak:$target" ;;
      unsupported) echo "$name -> unsupported" ;;
      unavailable) echo "$name -> not available (add a pkgmap entry)" ;;
    esac
  done
}

usage() {
  cat <<'EOF'
Usage: omarchy-pm <command> [names...]

Commands:
  install <names...>      Install missing packages (pkgmap-translated)
  remove <names...>       Remove installed packages
  search <query>          Search distro and flatpak repositories
  list-installed          List installed packages and flatpaks
  is-missing <names...>   Exit 0 if any named package is missing
  is-present <names...>   Exit 0 if all named packages are installed
  resolve <names...>      Print how each name resolves (diagnostics)
  update                  Update system packages via the active backend
  update-all              Update system packages and flatpaks

Backend: pacman (Arch) | dnf (Fedora) | apt (Debian/Ubuntu) | flatpak.
Override with OMARCHY_PM=dnf. Names resolve via ~/.config/omarchy/pkgmap/pkgmap.conf.
EOF
}

load_pkgmap

case "${1-}" in
  install) shift; cmd_install "$@" ;;
  remove) shift; cmd_remove "$@" ;;
  search) shift; cmd_search "${1-}" ;;
  list-installed) cmd_list_installed ;;
  is-missing) shift; cmd_is_missing "$@" ;;
  is-present) shift; cmd_is_present "$@" ;;
  update) cmd_update ;;
  update-all) cmd_update_all ;;
  resolve) shift; cmd_resolve "$@" ;;
  backend) echo "$BACKEND" ;;
  --help|-h|"") usage; exit 0 ;;
  *) echo "omarchy-pm: unknown command: $1" >&2; usage; exit 1 ;;
esac