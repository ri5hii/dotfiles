#!/bin/bash

# omarchy:summary=Diff your menu override (~/.config/omarchy/omarchy-menu.jsonc) against the runtime default
# omarchy:examples=omarchy menu diff | omarchy menu diff --no-color

# The override file replaces the runtime menu entirely (see docs/menu-override.md),
# so upstream additions never show up on their own. This shows exactly what
# your copy differs in — port over what you want from the right column.

set -u

user="$HOME/.config/omarchy/omarchy-menu.jsonc"
default="${OMARCHY_PATH:-/usr/share/omarchy}/default/omarchy/omarchy-menu.jsonc"

if [[ ! -f $user ]]; then
  echo "No menu override at ~/.config/omarchy/omarchy-menu.jsonc — the runtime default menu is in use."
  echo "To own your menu: cp \"$default\" \"$user\""
  exit 0
fi

if diff -u "$default" "$user" "$@"; then
  echo "Your menu override is identical to the runtime default."
fi

exit 0