#!/bin/bash
tmux kill-session -t dev 2>/dev/null
tmux new-session -d -s dev -n main

# Start with nvim in the first pane (full window)
tmux send-keys -t dev:main.0 nvim Enter

# Split right: opencode gets ~40% of the width, full height
tmux split-window -h -t dev:main.0 -l 40%
tmux send-keys -t dev:main.1 opencode Enter

# Split the left (nvim) pane horizontally: shell gets ~10% height at the bottom
tmux split-window -v -t dev:main.0 -l 10%

sleep 0.3

# Focus back on nvim
tmux select-pane -t dev:main.0
tmux switch-client -t dev
